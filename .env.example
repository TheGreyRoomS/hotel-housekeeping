# Copy this file to .env for local development
# DO NOT commit .env to version control

# PostgreSQL connection string (Railway/Render provide this automatically)
DATABASE_URL=postgresql://user:password@localhost:5432/hotel_housekeeping

# Secret key for JWT tokens — change this to any long random string
JWT_SECRET=change-me-to-something-long-and-random-like-this-abc123xyz

# Port (Railway/Render set this automatically; leave as 3000 for local)
PORT=3000
